#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
# vdc-cluster hub: state, token, tenant bridges + Geneve tunnels to every spoke
description="vdc-cluster hub overlay"

depend() {
  need net
  after nftables
  before dnsmasq libvirtd lab-api
}

start() {
  ebegin "Building hub overlay"
  mkdir -p /var/log/lab
  export LAB_TRACE_CTX="lab-hub (boot)"
  { /usr/local/sbin/hubctl init && /usr/local/sbin/hubctl apply; } >>/var/log/lab/hub.log 2>&1
  rc=$?
  # guests on the hub itself: libvirtd starts after us, so wait for it in the background
  ( i=0
    while [ $i -lt 120 ] && ! virsh -q list >/dev/null 2>&1; do sleep 2; i=$((i + 2)); done
    /usr/local/sbin/hubctl libvirt-sync >/dev/null 2>&1
    /usr/local/sbin/hubctl autostart hub ) >>/var/log/lab/hub.log 2>&1 &
  eend $rc
}
